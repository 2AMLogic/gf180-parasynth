# top-level verifier output directories (make controls writes build/<variant>/)
/build/

# render/analyse/accept manifest artifacts (tools/manifest.py, issue #68):
# plain-file CI artifacts with their own retention rules, not committed here.
/runs/
/jobs/
# LibreLane writes its run directory beside the config it was given, so a shuttle
# run lands inside the tree. Gigabytes of ODB/DEF per run; the evidence that is
# worth keeping is extracted into pnr/shuttle/evidence/ by collect-evidence.py.
pnr/shuttle/librelane/runs/
# PL_TARGET_DENSITY_PCT, written by run_librelane.py --density. An INPUT to global
# placement; not committed, so it can never be read back as a measurement.
pnr/shuttle/librelane/density.yaml
# ...with ONE exception, deliberately. `*.wav` above is right for renders in
# general, but docs/provenance/bd-decay-demo/ is the committed evidence that the
# corrected estimator can be re-run on old audio, and an evidence directory with
# no audio in it is summary statistics wearing a manifest. 211 kB, regenerated
# by `tools/stage_case.py demo --out docs/provenance/bd-decay-demo`.
!docs/provenance/bd-decay-demo/*.wav
# ...and a second: the simulated R0 reference audio (tools/r0_reference.py), the
# thing every physical capture is compared against. Each file's sha256 is in its
# .json beside it; tools/r0_capture.py refuses an altered one. Physical capture
# takes (captures/) stay ignored: they are archived with their hashes (#208).
!fpga/release/evidence/r0-reference/*.wav
# ...and R1's (#324), rendered on the build box from R1's frozen sources.
!fpga/release/evidence/r1-reference/*.wav
# ...and a second, for the same reason. docs/scorecard/drum-d02a-i2s/ is the
# evidence that D02A's board row was measured on the chip rather than the model,
# and the record's own `decoded_i2s_sha256` binds this artefact -- a hash with no
# file to hash is a claim. 208 kB, regenerated by
# `rtl-sketch/verify_synth_top.py --drum-solo SD --wav-out <path>`.
!docs/scorecard/drum-d02a-i2s/*.wav
# no trailing slash: `.venv/` matches a directory but NOT a symlink to one,
# which is how a venv symlink got staged by `git add -A` on another branch
.venv
build/

# the frozen reference profile: hashes and provenance are committed, audio is not
refprofile/cache/

# Pinned CI simulator source and release binary cache.
.tools/verilator-5.052/

# Repo Skills guard-hook logs (machine-local; carry absolute paths)
.claude/skills/repo/logs/
